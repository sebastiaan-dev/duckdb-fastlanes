# name: test/sql/numeric_dictionary.test
# description: Floating-point dictionary materialization across row groups
# group: [sql]

require fastlanes

statement ok
SET threads=4;

statement ok
CREATE TABLE dictionary_input AS
SELECT i::BIGINT AS id,
       i % 2 = 0 AS flag,
       (i % 500)::DOUBLE / 8 AS amount,
       CAST((i % 127)::DOUBLE / 8 AS FLOAT) AS single_amount,
       'value-' || i AS label
FROM range(200003) t(i);

statement ok
COPY dictionary_input TO '__TEST_DIR__/numeric_dictionary.fls' (FORMAT fls);

query I
SELECT count(*) FROM read_fls('__TEST_DIR__/numeric_dictionary.fls');
----
200003

query I
SELECT count(*) FROM (
    (SELECT * FROM dictionary_input
     EXCEPT ALL SELECT * FROM read_fls('__TEST_DIR__/numeric_dictionary.fls'))
    UNION ALL
    (SELECT * FROM read_fls('__TEST_DIR__/numeric_dictionary.fls')
     EXCEPT ALL SELECT * FROM dictionary_input)
);
----
0

statement ok
SET threads=1;

query I
SELECT count(*) FROM (
    (SELECT * FROM dictionary_input
     EXCEPT ALL SELECT * FROM read_fls('__TEST_DIR__/numeric_dictionary.fls'))
    UNION ALL
    (SELECT * FROM read_fls('__TEST_DIR__/numeric_dictionary.fls')
     EXCEPT ALL SELECT * FROM dictionary_input)
);
----
0
