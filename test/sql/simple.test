# name: test/sql/simple.test
# description: Portable FastLanes round trip, projections, filters and virtual columns
# group: [sql]

require fastlanes

statement ok
SET threads=1;

statement ok
CREATE TABLE original AS
SELECT i::INTEGER AS id, (i % 7)::INTEGER AS category,
       'value-' || i::VARCHAR AS label, (i * 0.25)::DOUBLE AS amount
FROM range(5003) t(i);

statement ok
COPY original TO '__TEST_DIR__/roundtrip.fls' (FORMAT fls, ROW_GROUP_SIZE 2048);

statement ok
CREATE VIEW roundtrip AS SELECT * FROM read_fls('__TEST_DIR__/roundtrip.fls');

query I
SELECT count(*) FROM ((SELECT * FROM original EXCEPT ALL SELECT * FROM roundtrip)
UNION ALL (SELECT * FROM roundtrip EXCEPT ALL SELECT * FROM original));
----
0

# Count-only scan, including the partial final vector.
query I
SELECT count(*) FROM roundtrip;
----
5003

query III
SELECT min(id), max(id), sum(id) FROM roundtrip;
----
0	5002	12512503

# Reordered/subset projections and filters that cross row-group boundaries.
query TI
SELECT label, id FROM roundtrip WHERE id IN (0, 2047, 2048, 4096, 5002) ORDER BY id;
----
value-0	0
value-2047	2047
value-2048	2048
value-4096	4096
value-5002	5002

query I
SELECT count(*) FROM roundtrip WHERE id >= 2040 AND id < 2060;
----
20

query I
SELECT count(*) FROM roundtrip WHERE id > 6000;
----
0

query III
SELECT count(*), min(file_row_number), max(file_row_number)
FROM read_fls('__TEST_DIR__/roundtrip.fls', file_row_number=true);
----
5003	0	5002

query I
SELECT count(*) FROM read_fls('__TEST_DIR__/roundtrip.fls', file_row_number=true)
WHERE id != file_row_number;
----
0

query I
SELECT count(*) FROM read_fls('__TEST_DIR__/roundtrip.fls', explicit_cardinality=5003);
----
5003

statement ok
SET threads=4;

query I
SELECT count(*) FROM ((SELECT * FROM original EXCEPT ALL SELECT * FROM roundtrip)
UNION ALL (SELECT * FROM roundtrip EXCEPT ALL SELECT * FROM original));
----
0

# Use different physical column orders to exercise per-file filter mappings.
statement ok
COPY (SELECT id, label FROM original WHERE id < 2048)
TO '__TEST_DIR__/union_a.fls' (FORMAT fls, ROW_GROUP_SIZE 2048);

statement ok
COPY (SELECT label, id FROM original WHERE id >= 2048)
TO '__TEST_DIR__/union_b.fls' (FORMAT fls, ROW_GROUP_SIZE 2048);

# Multiple readers must not share row-group cursors or retain stale filter mappings.
foreach thread_count 1 4

statement ok
SET threads=${thread_count};

query II
SELECT count(*), sum(id) FROM read_fls(['__TEST_DIR__/roundtrip.fls', '__TEST_DIR__/roundtrip.fls']);
----
10006	25025006

query I
SELECT count(*) FROM read_fls(['__TEST_DIR__/roundtrip.fls', '__TEST_DIR__/roundtrip.fls'])
WHERE id BETWEEN 2040 AND 2059;
----
40

query II
SELECT count(*), sum(id) FROM read_fls(['__TEST_DIR__/roundtrip.fls', '__TEST_DIR__/roundtrip.fls'], union_by_name=true);
----
10006	25025006

query I
SELECT count(*) FROM read_fls(['__TEST_DIR__/union_a.fls', '__TEST_DIR__/union_b.fls'], union_by_name=true)
WHERE id BETWEEN 2040 AND 2059;
----
20

query I
SELECT count(*) FROM ((SELECT id, label FROM original EXCEPT ALL
SELECT id, label FROM read_fls(['__TEST_DIR__/union_a.fls', '__TEST_DIR__/union_b.fls'], union_by_name=true))
UNION ALL (SELECT id, label FROM read_fls(['__TEST_DIR__/union_a.fls', '__TEST_DIR__/union_b.fls'], union_by_name=true)
EXCEPT ALL SELECT id, label FROM original));
----
0

endloop
